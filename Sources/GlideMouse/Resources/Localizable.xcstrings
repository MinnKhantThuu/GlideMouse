    "Limit right-side taps to the front of the mouse. Zero uses the whole right side.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit right-side taps to the front of the mouse. Zero uses the whole right side."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ညာကလစ်ကို ရှေ့ခြမ်းမှာပဲ ထိလို့ရအောင် ကန့်သတ်ပါ။ သုညထားရင် ညာခြမ်းတစ်ခုလုံးမှာ သုံးနိုင်ပါတယ်။"
          }
        },
        "zh-Hans": {
