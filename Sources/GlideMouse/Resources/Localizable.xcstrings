        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里试试滚动"
          }
        }
      }
    },
    "Native continuous Spaces, magnify and Smart Zoom are unavailable. Navigation actions use system or app shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native continuous Spaces, magnify and Smart Zoom are unavailable. Navigation actions use system or app shortcuts."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
