    "Prepare gestures here even without a Magic Mouse. These settings do not remap the buttons on your other mouse.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare gestures here even without a Magic Mouse. These settings do not remap the buttons on your other mouse."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Mouse မရှိသေးလည်း ဒီနေရာမှာ gesture တွေ ကြိုသတ်မှတ်ထားနိုင်ပါတယ်။ လက်ရှိသုံးနေတဲ့ တခြား mouse ရဲ့ ခလုတ်တွေကို မပြောင်းပါဘူး။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使还没有 Magic Mouse，也可以先设置手势。这些设置不会修改其他鼠标的按键。"
          }
        }
      }
    },
    "Use Magic Mouse touch gestures": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Magic Mouse touch gestures"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Mouse touch gesture များ သုံးမည်"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Magic Mouse 触控手势"
          }
        }
      }
    },
    "Touch input is experimental. Enable GlideMouse and allow its permissions to try it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch input is experimental. Enable GlideMouse and allow its permissions to try it."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch gesture တွေကို စမ်းသပ်ဆဲပါ။ စမ်းဖို့ GlideMouse ကို ဖွင့်ပြီး လိုအပ်တဲ့ permission တွေ ပေးထားပါ။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控功能仍在实验阶段。请启用 GlideMouse 并授予权限后试用。"
          }
        }
      }
    },
    "Your setup is saved. Touch input starts only when a supported Magic Mouse is connected and GlideMouse is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your setup is saved. Touch input starts only when a supported Magic Mouse is connected and GlideMouse is enabled."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆက်တင်တွေကို သိမ်းထားနိုင်ပါတယ်။ ပံ့ပိုးထားတဲ့ Magic Mouse ချိတ်ပြီး GlideMouse ကို ဖွင့်ထားမှ touch gesture တွေ အလုပ်လုပ်ပါမယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以保存设置。只有连接支持的 Magic Mouse 并启用 GlideMouse 后，触控手势才会运行。"
          }
        }
      }
    },
