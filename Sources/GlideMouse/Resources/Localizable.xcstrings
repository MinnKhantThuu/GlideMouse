    "How far the page scrolls as the second finger moves during a drag.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the page scrolls as the second finger moves during a drag."
          }
        },
        "my": {
