          }
        }
      }
    },
    "Tap and swipe distances are fractions of the touch surface. Timing is in seconds; drag scroll speed uses pixels per surface length.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and swipe distances are fractions of the touch surface. Timing is in seconds; drag scroll speed uses pixels per surface length."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap နဲ့ swipe အကွာအဝေးတွေက touch ဧရိယာရဲ့ အချိုးအစားပါ။ အချိန်ကို စက္ကန့်နဲ့ တိုင်းပါတယ်။ Drag scroll အမြန်နှုန်းက touch ဧရိယာတစ်ခုစာ ရွှေ့ရင် scroll လုပ်မယ့် pixel အရေအတွက်ပါ။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点和滑动距离按触控表面的比例计算。时间单位为秒；拖动时滚动速度按整个触控表面的像素数计算。"
          }
        }
      }
    },
