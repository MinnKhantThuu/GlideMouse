            "value": "把右侧轻点限制在鼠标前端。设为零时使用整个右侧区域。"
          }
        }
      }
    },
    "How long a stationary finger waits before new touches can ignore it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a stationary finger waits before new touches can ignore it."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ငြိမ်နေတဲ့ လက်ချောင်းကို ချထားတာလို့ သတ်မှတ်ဖို့ စောင့်မယ့်အချိန်ပါ။ အဲဒီနောက် ထပ်ထိတဲ့ လက်ချောင်းတွေကို သီးသန့်ဖတ်ပါမယ်။"
          }
        },
        "zh-Hans": {
