    },
    "Detect mouse buttons": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect mouse buttons"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse ခလုတ်များ ဖမ်းယူရန်"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别鼠标按钮"
          }
        }
      }
    },
    "Only buttons you have pressed are labelled. Left and right clicks stay unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only buttons you have pressed are labelled. Left and right clicks stay unchanged."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင်နှိပ်ပြီးသား ခလုတ်တွေကိုပဲ label ပြထားပါတယ်။ ဘယ်ခလုတ်နဲ့ ညာခလုတ်ကို ပုံမှန်အတိုင်း သုံးနိုင်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只标注你已按过的按钮。左右键的普通点击保持原样。"
          }
        }
      }
    },
    "Move into this box and press each wheel or side button once. Its label appears above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move into this box and press each wheel or side button once. Its label appears above."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဒီအကွက်ထဲကို mouse ရွှေ့ပြီး ဘီးခလုတ်နဲ့ ဘေးခလုတ်တွေကို တစ်ခုချင်း နှိပ်ပါ။ နှိပ်လိုက်တဲ့ခလုတ်ရဲ့ label ကို အပေါ်ပုံမှာ ပြပေးပါမယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移入此框，分别点击滚轮按钮或侧键，识别后会在上方显示标注。"
          }
        }
      }
    },
    "The drawing is a guide, not an exact image of your mouse. Detection identifies button numbers, not their physical positions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing is a guide, not an exact image of your mouse. Detection identifies button numbers, not their physical positions."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပုံက ခလုတ်ရွေးဖို့ လမ်းညွှန်ပုံပါ။ ခလုတ်နံပါတ်ကို ဖမ်းယူသိရှိနိုင်ပေမယ့် mouse ပေါ်က နေရာအတိအကျကိုတော့ မသိနိုင်ပါဘူး။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图仅用于说明，并非你的鼠标的精确外观。识别只能确定按钮编号，不能确定实际位置。"
          }
        }
      }
    },
    "Standard click": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard click"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပုံမှန် click"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通点击"
          }
        }
      }
    },
    "Wheel and side-button labels appear when you press them. Left and right clicks keep their standard actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheel and side-button labels appear when you press them. Left and right clicks keep their standard actions."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဘီးခလုတ်နဲ့ ဘေးခလုတ်တွေကို နှိပ်ပြီးမှ label ပြပေးပါတယ်။ ဘယ်/ညာခလုတ်တွေကတော့ ပုံမှန် click အတိုင်း အလုပ်လုပ်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击滚轮按钮和侧键后会显示对应标注。左右键保留普通点击功能。"
          }
        }
      }
    },
    "The update server has not been connected yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update server has not been connected yet."
