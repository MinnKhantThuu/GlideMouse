    "Reject a fast brush across the mouse even if the total movement is small.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject a fast brush across the mouse even if the total movement is small."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အကွာအဝေး နည်းနည်းပဲ ရွှေ့သွားလည်း မြန်မြန်ပွတ်ထိတာဆိုရင် click မလုပ်ပါဘူး။"
