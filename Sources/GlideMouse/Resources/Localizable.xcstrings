    },
    "Keep the app chooser open between swipes; select the highlighted app after this pause.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app chooser open between swipes; select the highlighted app after this pause."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe ထပ်လုပ်နိုင်ဖို့ app ရွေးတဲ့အကွက်ကို ဖွင့်ထားပါမယ်။ ဒီအချိန်ကြာအောင် ရပ်လိုက်ရင် ရွေးထားတဲ့ app ကို ပြောင်းပါမယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
