          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动下载并安装更新"
          }
        }
      }
    },
    "Automatic updates install signed releases when the app can safely restart. Your mouse settings are retained.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic updates install signed releases when the app can safely restart. Your mouse settings are retained."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "App ပြန်ဖွင့်နိုင်တဲ့အချိန်မှာ လက်မှတ်ထိုးထားတဲ့ version အသစ်ကို အလိုအလျောက် ထည့်ပေးပါတယ်။ သင့် mouse ဆက်တင်တွေကို ဆက်သိမ်းထားပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新会在应用可以安全重启时安装已签名的版本，并保留鼠标设置。"
          }
        }
      }
    },
