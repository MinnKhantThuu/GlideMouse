    "Trackpad and Magic Mouse continuous scrolling stays native. These settings process discrete mouse wheels only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad and Magic Mouse continuous scrolling stays native. These settings process discrete mouse wheels only."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad နှင့် Magic Mouse continuous scrolling ကိုပုံမှန်ထားပါတယ်။ ဒီဆက်တင်တွေက ပုံမှန် mouse wheel အတွက်သာဖြစ်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板和 Magic Mouse 的连续滚动保持系统原有方式。这些设置仅适用于普通鼠标滚轮。"
          }
        }
      }
    },
