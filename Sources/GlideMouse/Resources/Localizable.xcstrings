    "Presets replace mappings in the selected profile. Undo restores the previous settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets replace mappings in the selected profile. Undo restores the previous settings."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သက်ဆိုင်တဲ့ လုပ်ဆောင်ချက်တွေပဲ ပြောင်းပြီး တခြားသတ်မှတ်ချက်တွေကို ဆက်ထားပေးပါတယ်။ Undo နဲ့ အရင်အတိုင်း ပြန်ထားနိုင်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设会替换所选配置中的操作设置。撤销可恢复之前的设置。"
          }
        }
      }
    },
