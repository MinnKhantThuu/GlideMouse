    "Use buttons, fingers, wheel or a modifier key. Unmapped inputs pass through.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use buttons, fingers, wheel or a modifier key. Unmapped inputs pass through."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ခလုတ်နှိပ်တာနဲ့ ဘီးလှိမ့်တာအတွက် လုပ်ဆောင်ချက်တွေ သတ်မှတ်နိုင်ပါတယ်။ မသတ်မှတ်ထားတာတွေကို ပုံမှန်အတိုင်း သုံးနိုင်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用按钮、触摸、滚轮或修饰键。未设置的输入保持原有功能。"
          }
        }
      }
    },
    "Preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview"
          }
