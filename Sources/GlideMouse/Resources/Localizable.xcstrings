    "Tap once, then touch again and hold or move. Move the mouse to drag; lift that finger to release. Use another finger to scroll while dragging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap once, then touch again and hold or move. Move the mouse to drag; lift that finger to release. Use another finger to scroll while dragging."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တစ်ချက်ထိပြီး နောက်တစ်ချက်မှာ ဖိထားပါ၊ ဒါမှမဟုတ် ရွှေ့ပါ။ Mouse ကို ရွှေ့ရင် ဆွဲရွှေ့ပါမယ်။ အဲဒီလက်ချောင်းကို ဖယ်လိုက်ရင် လွှတ်ပါမယ်။ ဆွဲရွှေ့နေတုန်း တခြားလက်ချောင်းတစ်ချောင်းနဲ့ scroll လုပ်နိုင်ပါတယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一次，再次触摸并按住或移动。移动鼠标即可拖动，抬起该手指即可松开。拖动时可以用另一根手指滚动。"
          }
        }
      }
    },
    "Add a modifier key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a modifier key"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တွဲနှိပ်မည့် keyboard key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加修饰键"
          }
        }
      }
    },
    "An explicit modifier gesture overrides the ordinary one. Otherwise Command, Option, Control and Shift stay attached to click and drag actions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An explicit modifier gesture overrides the ordinary one. Otherwise Command, Option, Control and Shift stay attached to click and drag actions."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Key တွဲနှိပ်တဲ့ gesture ကို သီးသန့်သတ်မှတ်ထားရင် အဲဒီ action ကို သုံးပါမယ်။ မသတ်မှတ်ထားရင် Command၊ Option၊ Control၊ Shift တွေက click နဲ့ drag မှာ ပုံမှန်အတိုင်း ပါဝင်ပါမယ်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果单独设置了带修饰键的手势，就使用该操作。否则点击和拖动会保留 Command、Option、Control 和 Shift。"
          }
        }
      }
    },
