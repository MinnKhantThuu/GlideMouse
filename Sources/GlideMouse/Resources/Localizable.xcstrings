    "Wheel guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the wheel in the Scrolling preview. Shift moves horizontally; Control enables precision when configured."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling စမ်းသပ်နေရာတွင် wheel ကို လှိမ့်ကြည့်ပါ။ သတ်မှတ်ထားလျှင် Shift ဖြင့် ဘေးတိုက်၊ Control ဖြင့် ဖြည်းဖြည်း ရွှေ့နိုင်သည်။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚轮说明"
          }
        }
      }
    },
    "Touch guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch gestures require a recognized Magic Mouse and explicit opt-in. This diagram is a guide, not detected input."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch gesture အတွက် အသိအမှတ်ပြု Magic Mouse နှင့် ဖွင့်ရန် သဘောတူညီချက် လိုသည်။ ဤပုံသည် အသုံးပြုနည်းသာဖြစ်ပြီး လက်ရှိ input မဟုတ်ပါ။"
          }
        },
