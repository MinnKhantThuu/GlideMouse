    "Global events do not reliably identify the mouse. Per-device standard button and wheel overrides stay unavailable until attribution is verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global events do not reliably identify the mouse. Per-device standard button and wheel overrides stay unavailable until attribution is verified."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Global input မှာ ဘယ် mouse ကလာသလဲသေချာမခွဲနိုင်သေးပါ။ စက်အလိုက်ခလုတ်နှင့် wheel settings ကိုအတည်မပြုမီ မသုံးသေးပါ။"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局输入事件无法可靠区分鼠标。在设备识别得到验证之前，暂不支持按鼠标分别设置普通按钮和滚轮。"
          }
        }
      }
    },
    "Try scrolling here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling here"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
